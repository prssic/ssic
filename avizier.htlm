        <section class="view active" id="view-avizier">
            <div class="page-content">
                <h1 class="title-huge"><i>Avizier</i></h1>

                <!-- Listă de anunțuri, reutilizând exact componenta .calendar-section /
                     .calendar-list / .calendar-item de la pagina Evenimente (deja stilată,
                     deja responsive) — doar cu conținut de tip "anunț", nu "eveniment din
                     calendar". Ca să adaugi un anunț nou, copiază un ".calendar-item" întreg
                     și schimbă data/titlul/textul. Cel mai recent anunț ar trebui pus PRIMUL
                     (sus de tot), lista nefiind sortată automat. -->
                <div class="calendar-section reveal">
                    <h2><i data-lucide="megaphone" style="color:var(--c-accent); margin-right:10px;"></i>Anunțuri</h2>
                    <div class="calendar-list">
                        <div class="calendar-item hover-target">
                            <div class="calendar-date"><span class="cal-day">17</span><span class="cal-month">Sep</span></div>
                            <div class="calendar-info">
                                <h3>Bine ai venit pe Avizier</h3>
                                <p>Aici vor fi postate toate anunțurile importante ale SSIC. Șterge acest card și adaugă-le pe ale tale, copiind structura lui.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <footer class="global-footer"></footer>
        </section>
